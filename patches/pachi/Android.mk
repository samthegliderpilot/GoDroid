# Builds Pachi (third_party/pachi, pinned to tag pachi-12.90) as a standalone
# GTP-over-stdio executable, packaged the same way as patches/gnugo-3.8's own
# Android.mk - see that file's comment for why (the libpachi.so naming trick
# to get a real executable past Android's W^X restriction).
#
# This is deliberately a plain MCTS/UCT build, NOT upstream's default: Pachi's
# own Makefile enables DCNN (needs Caffe/OpenBLAS/glog/protobuf) and JOSEKIFIX
# (clones and CMake-builds KataGo at build time) by default, neither of which
# is realistic to cross-compile for Android. Leaving DCNN/JOSEKIFIX/etc.
# entirely undefined here compiles out every #ifdef guarding them, same as
# running Pachi's own `make DCNN=0` (plain `--nodcnn` play, matching the
# README's own "kgs 2k (mcts only)" mode) - confirmed by reading each
# subdirectory's own Makefile for exactly which .c files it builds under that
# configuration; the list below mirrors that, by hand, since Android.mk has no
# conditional-compile machinery for this to re-derive automatically.
#
# build.h is normally generated by Pachi's own `genbuild` (a bash script that
# shells out to git and the compiler) - pre-generated as a patch file instead
# (patches/pachi/build.h), same pattern as patches/gnugo-3.8/config.h.

LOCAL_PATH := $(call my-dir)

include $(CLEAR_VARS)

LOCAL_MODULE := pachi-12.90

LOCAL_MODULE_FILENAME := libpachi

# -fno-strict-aliasing -fwrapv: Pachi's upstream build (Makefile) defaults to
# -O3 under GCC with no explicit aliasing/overflow safety flags - its pattern-
# matching code (pattern3.c, spatial.c et al) leans on bit-tricks/type-punning
# the kind of code that's traditionally tolerant of GCC's specific UB handling
# but not guaranteed safe under a different compiler (NDK's clang) at a
# similar optimization level. These two flags are a standard, low-cost
# mitigation for porting exactly this class of legacy C code to a new
# compiler, not a hack - added after a native SIGSEGV during Pachi's first
# genmove on-device turned out unrelated to threading (reproduced identically
# with threads=1).
#
# -DEXTRA_CHECKS -UNDEBUG: root-caused a reliable native SIGSEGV (crashed on
# literally any genmove, any board) to board_undo.c's restore_suicide() ->
# group_info(b, old_group), called without group_at(b, old_group) having been
# set to old_group first. That assignment exists in the source already, but
# only #ifdef EXTRA_CHECKS - its own comment ("make group_info() checks
# happy") frames it as purely a debug-assertion nicety, but it's actually
# load-bearing for this call path (board_quick_play/board_quick_undo, used by
# with_move() - e.g. nakade_making_dead_shape's shape-detection probing):
# without it, group_info() resolves to the wrong memory and corrupts it.
# Confirmed empirically: the exact same crash, reproduced identically with
# threads=1 (not a threading bug) and with -fno-strict-aliasing -fwrapv
# already in place (not a strict-aliasing/overflow UB bug), stopped happening
# the moment this build enabled EXTRA_CHECKS. NDK's APP_OPTIM=release
# implicitly defines NDEBUG, which no-ops the assert() calls EXTRA_CHECKS
# adds unless explicitly undefined here too. Kept permanently, not as a
# one-off diagnostic: this is also the exact configuration Pachi's own
# Makefile says to test releases with ("Make sure to run tests and play
# games with EXTRA_CHECKS on before a new release. If something breaks with
# EXTRA_CHECKS on it's a bug.") - a documented, upstream-sanctioned mode, not
# a local hack, and the "slightly slower" cost it describes is an acceptable
# trade for a build that doesn't segfault on its first move.
LOCAL_CFLAGS := -std=gnu99 -pthread -D_GNU_SOURCE -fno-strict-aliasing -fwrapv -DEXTRA_CHECKS -UNDEBUG \
-Wall -Wsign-compare -Wno-format-zero-length -Winit-self -Wimplicit-fallthrough \
-I$(LOCAL_PATH)

LOCAL_SRC_FILES := \
\
board.c \
board_undo.c \
engine.c \
gogui.c \
gtp.c \
move.c \
ownermap.c \
pachi.c \
pattern3.c \
playout.c \
random.c \
stone.c \
timeinfo.c \
fbook.c \
chat.c \
util.c \
\
engines/montecarlo.c \
engines/random.c \
engines/replay.c \
\
joseki/joseki.c \
joseki/joseki_engine.c \
joseki/josekiload.c \
\
josekifix/override.c \
\
pattern/pattern.c \
pattern/mcowner.c \
pattern/criticality.c \
pattern/pattern_engine.c \
pattern/prob.c \
pattern/spatial.c \
\
playout/moggy.c \
playout/light.c \
\
tactics/dragon.c \
tactics/seki.c \
tactics/1lib.c \
tactics/2lib.c \
tactics/nlib.c \
tactics/ladder.c \
tactics/nakade.c \
tactics/selfatari.c \
tactics/bent4.c \
tactics/util.c \
\
